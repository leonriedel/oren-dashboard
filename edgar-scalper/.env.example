# EDGAR SCALPER — environment
# Copy to .env and fill in. NEVER commit a filled .env.

# --- Supabase (mandatory) ---
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- mode ---
# paper = simulated trades to Supabase only
# live  = real OANDA orders (needs OANDA vars below)
MODE=paper

# --- OANDA (only needed when MODE=live) ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
